# Kopieren nach ".env" und anpassen.
BG_SCHOOL_NAME=Schule Musterhausen
# Lokales Sprachmodell (Ollama)
BG_OLLAMA_URL=http://127.0.0.1:11434
BG_MODEL=gemma3:12b
# Embedding-Modell für die semantische Suche (leer = nur Stichwortsuche)
BG_EMBED_MODEL=bge-m3
# Kontextlänge in Tokens (mehr = mehr Unterlagen, braucht mehr Grafikspeicher)
BG_NUM_CTX=16384
BG_TEMPERATURE=0.4
# Speicherort für Datenbank (enthält besonders schützenswerte Personendaten!)
BG_DATA_DIR=./data
BG_SESSION_HOURS=8
# Auf 1 setzen, wenn ein HTTPS-Reverse-Proxy vorgeschaltet ist
BG_HTTPS_ONLY=0
